{
  "name": "@functions-oneui/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "OneUI Design System monorepo",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "10.0.0"
  },
  "scripts": {
    "dev:storybook": "pnpm --filter @functions-oneui/storybook run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && node ./scripts/audit-scripts.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "node ./scripts/run-vitest-ui.mjs",
    "verify": "node ./scripts/run-verify.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "audit:scripts": "node ./scripts/audit-scripts.mjs",
    "audit:registry": "node ./scripts/audit-registry-bom.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@typescript-eslint/parser": "8.56.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "eslint": "9.39.3",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.1",
    "turbo": "2.8.16",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
