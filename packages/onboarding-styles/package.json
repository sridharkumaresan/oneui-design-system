{
  "name": "@functions-oneui/onboarding-styles",
  "version": "0.0.0-local-20260410175351",
  "description": "Token-driven CSS and visual helpers for OneUI onboarding experiences.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "lint": "eslint . --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/styles.test.mjs"
  },
  "dependencies": {
    "@functions-oneui/onboarding-core": "workspace:*",
    "@functions-oneui/tokens": "workspace:*",
    "driver.js": "1.4.0"
  }
}
