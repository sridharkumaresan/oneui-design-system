{
  "name": "@functions-oneui/react-utils",
  "version": "0.0.0-local-20260410175351",
  "description": "React-focused utilities shared by UI packages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image-loading": {
      "types": "./dist/image-loading/index.d.ts",
      "import": "./dist/image-loading/index.js"
    },
    "./progressive-loading": {
      "types": "./dist/progressive-loading/index.d.ts",
      "import": "./dist/progressive-loading/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@functions-oneui/utils": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "25.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
