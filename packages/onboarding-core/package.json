{
  "name": "@functions-oneui/onboarding-core",
  "version": "0.0.0-local-20260410175351",
  "description": "Framework-agnostic onboarding orchestration for OneUI, backed by Driver.js.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "driver.js": "1.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "jsdom": "25.0.1",
    "vitest": "2.1.9"
  }
}
