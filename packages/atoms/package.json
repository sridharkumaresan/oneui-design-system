{
  "name": "@functions-oneui/atoms",
  "version": "0.0.0-local-20260410175351",
  "description": "Atomic building blocks for the OneUI component library.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@functions-oneui/react-utils": "workspace:*",
    "@functions-oneui/theme": "workspace:*",
    "@functions-oneui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@fluentui/react-components": "9.73.0",
    "@functions-oneui/testing": "workspace:*",
    "@testing-library/react": "16.3.2",
    "jsdom": "25.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vitest": "2.1.9"
  }
}
